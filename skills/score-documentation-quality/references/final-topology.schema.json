{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/score-documentation-quality/final-topology.schema.json",
  "title": "Final instruction topology policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "root_nodes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "allowed_root_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_root_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {"required": ["parent", "child"], "additionalProperties": false, "properties": {"parent": {"type": "string"}, "child": {"type": "string"}}},
          {"required": ["from", "to"], "additionalProperties": false, "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}
        ]
      }
    },
    "parent_rules": {
      "type": "object",
      "additionalProperties": {"enum": ["none", "exactly_one", "any"]}
    },
    "single_parent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exactly_one_parent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "no_parent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allow_additional_peer_routes": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "object", "additionalProperties": {"type": "boolean"}}
      ]
    },
    "forbidden_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {"required": ["parent", "child"], "additionalProperties": false, "properties": {"parent": {"type": "string"}, "child": {"type": "string"}}},
          {"required": ["from", "to"], "additionalProperties": false, "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}
        ]
      }
    }
  }
}

