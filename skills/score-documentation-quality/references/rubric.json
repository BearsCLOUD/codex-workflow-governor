        {"id": "primary_source_alignment", "name": "Соответствие первичным источникам", "points": 5},
        {"id": "examples_commands_verified", "name": "Проверка примеров и команд", "points": 4},
        {"id": "assumptions_uncertainty", "name": "Предположения и неизвестное", "points": 3},
        {"id": "freshness_revision", "name": "Версия и актуальность", "points": 3}
