        {"id": "identity_hierarchy", "name": "Идентичность и иерархия", "points": 3},
        {"id": "navigation", "name": "Навигация", "points": 3},
        {"id": "links_anchors", "name": "Ссылки и якоря", "points": 2},
        {"id": "task_findability", "name": "Поиск по задаче", "points": 2}
      ]
    },
    {
      "id": "maintainability",
      "name": "Сопровождаемость",
      "criteria": [
        {"id": "single_owner", "name": "Один владелец факта", "points": 3},
        {"id": "duplication_control", "name": "Контроль дублирования", "points": 3},
        {"id": "lifecycle_change", "name": "Жизненный цикл изменений", "points": 2},
        {"id": "portability", "name": "Переносимость", "points": 2}
      ]
    },
    {
      "id": "language_accessibility",
      "name": "Ясность и доступность",
      "criteria": [
        {"id": "clarity", "name": "Ясность", "points": 2},
        {"id": "normative_language", "name": "Однозначная обязательность", "points": 1},
