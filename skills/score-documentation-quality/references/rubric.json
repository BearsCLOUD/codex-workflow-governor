  "systemic_gates": {
    "critical_authority_conflict": {"name": "Критический конфликт полномочий", "cap": 39, "minimum_evidence": 2},
    "operational_contradiction": {"name": "Операционное противоречие", "cap": 59, "minimum_evidence": 2},
    "missing_core_authority": {"name": "Отсутствует основная authority", "cap": 59, "minimum_evidence": 1},
    "broken_core_path": {"name": "Неработающий основной путь", "cap": 69, "minimum_evidence": 1},
    "material_ambiguity": {"name": "Существенная неоднозначность", "cap": 79, "minimum_evidence": 1},
    "material_primary_source_mismatch": {"name": "Существенное расхождение с первичным источником", "cap": 59, "minimum_evidence": 2}
  },
  "levels": [
    {"minimum": 90, "name": "эталонная"},
    {"minimum": 80, "name": "надёжная"},
    {"minimum": 70, "name": "рабочая"},
    {"minimum": 60, "name": "ограниченно пригодная"},
    {"minimum": 40, "name": "рискованная"},
    {"minimum": 0, "name": "непригодная"}
  ]
}
