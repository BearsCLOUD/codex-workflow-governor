        {"id": "decision_branches", "name": "Решения на развилках", "points": 4},
        {"id": "observable_results", "name": "Наблюдаемые результаты", "points": 4},
        {"id": "safe_stop_escalation", "name": "Безопасная остановка и эскалация", "points": 3}
