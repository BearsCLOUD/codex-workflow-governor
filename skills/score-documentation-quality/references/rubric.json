{
  "schema_version": "2.0",
  "calculation": {
    "precision": 0.5,
    "set_aggregation": "single_document_system_no_averaging",
    "status_factors": {
      "met": {"minimum": 1.0, "maximum": 1.0},
      "partial": {"minimum": 0.5, "maximum": 0.5},
      "unmet": {"minimum": 0.0, "maximum": 0.0},
      "unknown": {"minimum": 0.0, "maximum": 1.0}
    },
