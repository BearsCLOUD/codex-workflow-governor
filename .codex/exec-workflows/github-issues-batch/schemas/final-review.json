{
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["approved", "rejected", "no-issues", "blocked"]},
    "summary": {"type": "string"},
    "issue_snapshot_digest": {"type": "string"},
    "reviewed_tree_digest": {"type": "string"},
    "reviewed_diff_digest": {"type": "string"},
    "reviewed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "mode": {"type": "string"},
          "change": {"type": "string", "enum": ["added", "modified", "deleted"]},
          "sha256": {"type": "string"}
        },
        "required": ["path", "mode", "change", "sha256"],
        "additionalProperties": false
      }
    },
    "issue_traces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {"type": "integer"},
          "content_digest": {"type": "string"},
          "plan_disposition": {"type": "string", "enum": ["implement", "duplicate", "superseded"]},
          "depends_on": {"type": "array", "items": {"type": "integer"}},
          "design_required": {"type": "boolean"},
          "design_ref": {"type": "string"},
          "acceptance": {"type": "array", "items": {"type": "string"}},
          "files": {"type": "array", "items": {"type": "string"}},
          "tests": {"type": "array", "items": {"type": "string"}},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["number", "content_digest", "plan_disposition", "depends_on", "design_required", "design_ref", "acceptance", "files", "tests", "finding_ids"],
        "additionalProperties": false
      }
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {"type": "string"},
          "status": {"type": "string", "enum": ["resolved", "rejected"]},
          "resolution": {"type": "string"},
          "test": {"type": "string"}
        },
        "required": ["finding_id", "status", "resolution", "test"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "issue_numbers": {"type": "array", "items": {"type": "integer"}},
          "summary": {"type": "string"},
          "evidence": {"type": "string"}
        },
        "required": ["id", "severity", "issue_numbers", "summary", "evidence"],
        "additionalProperties": false
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed"]},
          "evidence": {"type": "string"}
        },
        "required": ["name", "status", "evidence"],
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["status", "summary", "issue_snapshot_digest", "reviewed_tree_digest", "reviewed_diff_digest", "reviewed_paths", "issue_traces", "finding_dispositions", "findings", "validations", "blockers"],
  "additionalProperties": false
}
